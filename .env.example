# Backend only. Copy to backend/.env; never put the NVIDIA key in frontend variables.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
DATABASE_URL=sqlite:///./meetings.db
# For PostgreSQL, use postgresql+psycopg://user:password@localhost:5432/meeting_notes
APP_ENV=development
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
TRANSCRIPT_MAX_SIZE_MB=10
LLM_TIMEOUT_SECONDS=90
